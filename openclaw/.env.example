# ─────────────────────────────────────────────
# OpenClaw Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ─────────────────────────────────────────────

# ANTHROPIC — Required. Powers Kirsten + all Claude-based agents.
ANTHROPIC_API_KEY=

# GOOGLE AI — Required for Researcher (Gemini Flash), Marketing (Gemini Pro), Designer (Imagen 3).
# Get free key at: https://ai.google.dev
GOOGLE_AI_API_KEY=

# OPENAI — Optional fallback for Designer if Imagen 3 is unavailable.
OPENAI_API_KEY=

# SERVER — Port the Express API runs on. Default: 3001.
PORT=3001

# CLOUDFLARE R2 — Production only. Used for persistent agent memory storage.
# Leave blank for local development (uses ./memory/ directory instead).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=openclaw-memory
R2_ENDPOINT=
